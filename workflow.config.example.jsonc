// workflow.config.example.jsonc
// Reference for every option the AI Workflow Harness understands.
// Copy this to `workflow.config.json` and remove the comments (strict JSON has none).
// Anything optional can be omitted entirely; shown here with example values.

{
  // ── Package manager (JS/TS repos only, informational) ───────────────────────
  // Tells the agent which runner to assume in docs/commands.
  // Allowed: "pnpm" | "npm" | "yarn" | "bun" | "none"
  "packageManager": "pnpm",

  // ── Feedback commands ───────────────────────────────────────────────────────
  // Commands the agent runs before every commit (do-work) and inside the AFK loop.
  // They run in the order listed. Set any value to "" to skip it.
  // Keys are free-form — add/remove to match your stack. Examples per language below.
  "feedback": {
    "install": "pnpm install",     // optional: environment setup, run before checks
    "test": "pnpm test",           // unit/integration tests
    "typecheck": "pnpm typecheck", // static type checking ("" if none)
    "lint": "pnpm lint",           // linter ("" to skip)
    "format": "",                  // optional: formatter check, e.g. "prettier --check ."
    "build": ""                    // optional: production build to catch build-time errors
  },

  // ── GitHub labels that drive the workflow ───────────────────────────────────
  // Rename the values to match labels that already exist in your repo.
  // The AFK loop works ONLY issues carrying the `afk` label.
  "labels": {
    "afk": "afk",           // autonomous: the loop may complete and merge this
    "hitl": "hitl",         // human-in-the-loop required (design, migration, review)
    "critical": "critical"  // bugfix fast-track: prioritized first by the loop
  },

  // ── Conventions file ────────────────────────────────────────────────────────
  // Where this project's coding standards live. The `coding-standards` skill reads
  // this; if the file is absent it derives conventions from the codebase.
  "conventionsFile": "CONVENTIONS.md",

  // ── Autonomous loop defaults (optional, reference) ──────────────────────────
  // These mirror the values set in `.sandcastle/main.ts` / `interactive.ts`.
  // Update them here for documentation AND in those files (the runner reads them there).
  "loop": {
    "model": "claude-opus-5",                        // agent model slug
    "maxIterations": 3,                                // max tasks per run (1 task/iteration)
    "completionSignal": "<promise>NO MORE TASKS</promise>", // stops the loop when emitted
    "sandbox": "docker"                                // "docker" (main.ts) | "none" (interactive.ts)
  }

  // ── Per-language feedback examples (copy into "feedback" above) ──────────────
  // Node (npm):     { "test": "npm test", "typecheck": "tsc --noEmit", "lint": "eslint .", "build": "npm run build" }
  // Python:         { "test": "pytest", "typecheck": "mypy .", "lint": "ruff check .", "format": "black --check ." }
  // Go:             { "test": "go test ./...", "typecheck": "go vet ./...", "lint": "golangci-lint run", "build": "go build ./..." }
  // Rust:           { "test": "cargo test", "typecheck": "cargo check", "lint": "cargo clippy -- -D warnings", "build": "cargo build --release" }
  // Java (Maven):   { "test": "mvn test", "build": "mvn -q package", "lint": "" }
}
