{
  "name": "@prismetic/strapi-plugin-ai-bulk-translate",
  "version": "1.2.0",
  "description": "Bulk AI translation for Strapi v5, with admin-managed providers and models",
  "license": "MIT",
  "author": "Prismetic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prismetic/strapi-plugin-ai-bulk-translate.git"
  },
  "bugs": {
    "url": "https://github.com/Prismetic/strapi-plugin-ai-bulk-translate/issues"
  },
  "homepage": "https://github.com/Prismetic/strapi-plugin-ai-bulk-translate#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "keywords": [
    "strapi",
    "plugin",
    "i18n",
    "localization",
    "translation",
    "ai",
    "llm"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "postbuild": "node scripts/assert-esm-boundary.mjs",
    "prepublishOnly": "npm run build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "push": "node scripts/push-to-host.mjs",
    "verify": "strapi-plugin verify",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p admin/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.42",
    "@ai-sdk/azure": "^4.0.49",
    "@ai-sdk/google": "^4.0.51",
    "@ai-sdk/openai": "^4.0.47",
    "@ai-sdk/openai-compatible": "^3.0.37",
    "@strapi/design-system": "^2.2.1",
    "@strapi/icons": "^2.2.1",
    "ai": "^7.0.77",
    "react-intl": "^7.1.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.49.0",
    "@strapi/typescript-utils": "^5.49.0",
    "@testing-library/react": "^15.0.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "styled-components": "^6.1.18",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.27.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "ai-bulk-translate",
    "displayName": "AI Bulk Translate",
    "description": "Bulk AI translation for Strapi v5, with admin-managed providers and models"
  },
  "engines": {
    "node": ">=22.0.0 <=26.x.x"
  }
}
